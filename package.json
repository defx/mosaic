{
  "name": "mosaic",
  "type": "module",
  "version": "1.1.0",
  "description": "A JavaScript library for progressive enhancing HTML",
  "main": "dist/mosaic.js",
  "browser": "dist/mosaic.js",
  "unpkg": "dist/mosaic.min.js",
  "module": "dist/mosaic.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:install-browsers": "playwright install chromium firefox webkit",
    "size": "gzip -c9 ./dist/mosaic.min.js | wc -c",
    "build": "rm -rf dist cjs && npm run typecheck && tsc -p tsconfig.build.json && rollup -c && npm run size",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/mosaic.js",
    "dist/mosaic.min.js",
    "dist/types"
  ],
  "directories": {
    "test": "test"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@types/node": "^24.0.0",
    "playwright": "1.64.1",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mosaic.js",
      "default": "./dist/mosaic.js"
    },
    "./dist/mosaic.min.js": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mosaic.min.js",
      "default": "./dist/mosaic.min.js"
    }
  }
}
